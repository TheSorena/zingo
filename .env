# The public URL where your application is hosted (used for metadata and SEO)
NEXT_PUBLIC_APP_URL=https://cinemaplus-app.vercel.app

# The base URL for your API endpoints
API_BASE_URL=https://hostinnegar.com

# Google Analytics Measurement ID (GA4)
# Format: G-XXXXXXXXXX
# Get this from Google Analytics > Admin > Data Streams > Web > Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification meta tag content
# Get this from Google Search Console > Property Settings > Ownership verification > HTML tag
# Copy only the content value from the meta tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=